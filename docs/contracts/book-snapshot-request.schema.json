{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depthsift:companion:book-snapshot-request:1",
  "title": "DepthSift book.snapshot.request payload",
  "description": "Specification 1.3, sections 5.1, 9.3, 9.5 and 11.2. One exchange read of one instrument through one logical connection, carrying the resolved binding context, the request generation, a one-time permit and the reserved weight. zoom_index is fixed at 0; depth_levels and depth_percent are never sent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrument_key", "logical_connection_key", "profile_id", "config_revision", "binding_id", "binding_revision", "source_epoch", "request_generation", "timeout_ms", "permit_id", "limit_scope_id", "limit_epoch", "weight", "params"],
  "properties": {
    "instrument_key": {"$ref": "urn:depthsift:companion:common:1#/$defs/instrument_key"},
    "logical_connection_key": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "profile_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "config_revision": {"$ref": "urn:depthsift:companion:common:1#/$defs/revision"},
    "binding_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "binding_revision": {"$ref": "urn:depthsift:companion:common:1#/$defs/revision"},
    "source_epoch": {"$ref": "urn:depthsift:companion:common:1#/$defs/epoch"},
    "request_generation": {"$ref": "urn:depthsift:companion:common:1#/$defs/revision"},
    "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
    "permit_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "limit_scope_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "limit_epoch": {"$ref": "urn:depthsift:companion:common:1#/$defs/epoch"},
    "weight": {"type": "integer", "minimum": 0, "maximum": 10000},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoom_index"],
      "properties": {"zoom_index": {"const": 0}}
    }
  }
}
