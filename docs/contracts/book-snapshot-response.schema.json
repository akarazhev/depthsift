{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depthsift:companion:book-snapshot-response:1",
  "title": "DepthSift book.snapshot.response payload",
  "description": "Specification 1.3, sections 5.1, 6.3, 9.3, 9.5 and 11.4. Echoes the request identity, then carries either a snapshot or a typed error. not_dispatched=true is meaningful only together with a NOT_DISPATCHED resolution; without it the reservation stays. Prices and quantities are decimal strings; bestBid and bestAsk are never added to the level arrays.",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrument_key", "logical_connection_key", "binding_id", "binding_revision", "source_epoch", "request_generation", "permit_id", "limit_scope_id", "limit_epoch", "outcome", "not_dispatched", "execution_context_id", "resolution", "snapshot", "error"],
  "properties": {
    "instrument_key": {"$ref": "urn:depthsift:companion:common:1#/$defs/instrument_key"},
    "logical_connection_key": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "binding_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "binding_revision": {"$ref": "urn:depthsift:companion:common:1#/$defs/revision"},
    "source_epoch": {"$ref": "urn:depthsift:companion:common:1#/$defs/epoch"},
    "request_generation": {"$ref": "urn:depthsift:companion:common:1#/$defs/revision"},
    "permit_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "limit_scope_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "limit_epoch": {"$ref": "urn:depthsift:companion:common:1#/$defs/epoch"},
    "outcome": {"enum": ["snapshot", "error"]},
    "not_dispatched": {"type": "boolean"},
    "execution_context_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_id"},
    "resolution": {"oneOf": [{"$ref": "urn:depthsift:companion:permit-resolution:1#/$defs/resolution"}, {"type": "null"}]},
    "snapshot": {"oneOf": [{"$ref": "#/$defs/snapshot"}, {"type": "null"}]},
    "error": {"oneOf": [{"$ref": "urn:depthsift:companion:common:1#/$defs/typed_error"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "snapshot"}}},
      "then": {
        "properties": {
          "snapshot": {"$ref": "#/$defs/snapshot"},
          "error": {"type": "null"},
          "not_dispatched": {"const": false},
          "resolution": {"type": "null"},
          "execution_context_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "error"}}},
      "then": {"properties": {"snapshot": {"type": "null"}, "error": {"$ref": "urn:depthsift:companion:common:1#/$defs/typed_error"}}}
    },
    {
      "if": {"properties": {"not_dispatched": {"const": true}}},
      "then": {
        "properties": {
          "outcome": {"const": "error"},
          "resolution": {
            "$ref": "urn:depthsift:companion:permit-resolution:1#/$defs/resolution",
            "properties": {"outcome": {"const": "NOT_DISPATCHED"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"not_dispatched": {"const": false}}},
      "then": {"properties": {"resolution": {"type": "null"}}}
    }
  ],
  "$defs": {
    "level": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "urn:depthsift:companion:common:1#/$defs/decimal"},
        {"$ref": "urn:depthsift:companion:common:1#/$defs/decimal"}
      ],
      "items": false
    },
    "side_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "basis", "levels_returned", "boundary_price"],
      "properties": {
        "complete": {"type": "boolean"},
        "basis": {"enum": ["SOURCE_CONTRACT", "SIDE_EXHAUSTED", "UNCONFIRMED"]},
        "levels_returned": {"type": "integer", "minimum": 0},
        "boundary_price": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_decimal"}
      },
      "allOf": [
        {
          "if": {"properties": {"complete": {"const": true}}},
          "then": {"properties": {"basis": {"enum": ["SOURCE_CONTRACT", "SIDE_EXHAUSTED"]}}}
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["received_at_ms", "fresh_on_request", "source_timestamp_ms", "upstream_update_id", "zoom_index", "grouping", "continuous_from_top", "best_bid", "best_ask", "bids", "asks", "coverage"],
      "properties": {
        "received_at_ms": {"$ref": "urn:depthsift:companion:common:1#/$defs/milliseconds"},
        "fresh_on_request": {"type": "boolean"},
        "source_timestamp_ms": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_milliseconds"},
        "upstream_update_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "zoom_index": {"const": 0},
        "grouping": {"enum": ["NONE", "UNKNOWN"]},
        "continuous_from_top": {"type": "boolean"},
        "best_bid": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_decimal"},
        "best_ask": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_decimal"},
        "bids": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/level"}},
        "asks": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/level"}},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bids", "asks"],
          "properties": {
            "bids": {"$ref": "#/$defs/side_coverage"},
            "asks": {"$ref": "#/$defs/side_coverage"}
          }
        }
      }
    }
  }
}
