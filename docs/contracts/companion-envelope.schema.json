{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depthsift:companion:envelope:1",
  "title": "DepthSift Companion protocol 1 envelope",
  "description": "Specification 1.3, section 9.5. Validates the common envelope and dispatches payload validation by message_type: hello, welcome, book.snapshot.request, book.snapshot.response, instrument.open, request.cancel, limit.pause, limit.paused, requests.quiesce, requests.quiesced and error. Paired operations that share a message_type are told apart by the presence of request_id. Session, sequence, correlation, duplicate JSON keys and byte-size checks are mandatory outside JSON Schema. health, heartbeat, connections.list, instruments.list, terminal.targets.list and terminal.target.state still need their own payload schemas before capability activation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "message_type", "session_id", "message_id", "seq", "payload"],
  "properties": {
    "protocol_version": {"const": 1},
    "message_type": {
      "enum": [
        "hello", "welcome", "health", "heartbeat", "connections.list",
        "instruments.list", "terminal.targets.list", "terminal.target.state",
        "limit.pause", "limit.paused", "requests.quiesce", "requests.quiesced",
        "book.snapshot.request", "book.snapshot.response", "instrument.open",
        "request.cancel", "error"
      ]
    },
    "session_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "message_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "seq": {"type": "integer", "minimum": 0},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"message_type": {"const": "hello"}}},
      "then": {
        "properties": {"session_id": {"type": "null"}},
        "not": {"required": ["request_id"]}
      },
      "else": {"properties": {"session_id": {"$ref": "#/$defs/id"}}}
    },
    {
      "if": {"properties": {"message_type": {"enum": ["hello", "welcome"]}}},
      "then": {"properties": {"seq": {"const": 0}}},
      "else": {"properties": {"seq": {"minimum": 1}}}
    },
    {
      "if": {"properties": {"message_type": {"enum": ["welcome", "book.snapshot.response", "limit.paused", "requests.quiesced"]}}},
      "then": {"required": ["request_id"]}
    },
    {
      "if": {"properties": {"message_type": {"enum": ["book.snapshot.request", "limit.pause", "requests.quiesce"]}}},
      "then": {"not": {"required": ["request_id"]}}
    },
    {
      "if": {"properties": {"message_type": {"const": "hello"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:hello:1"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "welcome"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:welcome:1"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "book.snapshot.request"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:book-snapshot-request:1"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "book.snapshot.response"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:book-snapshot-response:1"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "instrument.open"}}, "required": ["request_id"]},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:instrument-open:1#/$defs/response"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "instrument.open"}}, "not": {"required": ["request_id"]}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:instrument-open:1#/$defs/request"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "request.cancel"}}, "required": ["request_id"]},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:request-cancel:1#/$defs/response"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "request.cancel"}}, "not": {"required": ["request_id"]}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:request-cancel:1#/$defs/request"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "limit.pause"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:limit-pause:1#/$defs/pause"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "limit.paused"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:limit-pause:1#/$defs/paused"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "requests.quiesce"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:requests-quiesce:1"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "requests.quiesced"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:permit-resolution:1"}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "error"}}},
      "then": {"properties": {"payload": {"$ref": "urn:depthsift:companion:error:1"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}
  }
}
