{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depthsift:companion:hello:1",
  "title": "DepthSift hello payload",
  "description": "Specification 1.3, sections 5.3, 9.1, 9.3 and 9.5. Sent by Companion with session_id null and seq 0. auth carries the one-time pairing token or the long-lived connection secret, so this payload must never reach the journal or diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["companion_id", "companion_instance_id", "companion_version", "protocol_versions", "auth", "platform", "operations", "sdk_version", "terminal_version", "limits"],
  "properties": {
    "companion_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "companion_instance_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "companion_version": {"$ref": "urn:depthsift:companion:common:1#/$defs/version_string"},
    "protocol_versions": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["pairing_token", "connection_secret"]},
        "value": {"type": "string", "minLength": 16, "maxLength": 512}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "emulated"],
      "properties": {
        "os": {"enum": ["windows", "macos", "linux"]},
        "arch": {"enum": ["x64", "arm64"]},
        "emulated": {"type": "boolean"}
      }
    },
    "operations": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:depthsift:companion:common:1#/$defs/operation"}},
    "sdk_version": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_version_string"},
    "terminal_version": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_version_string"},
    "limits": {"$ref": "urn:depthsift:companion:common:1#/$defs/limits"}
  }
}
