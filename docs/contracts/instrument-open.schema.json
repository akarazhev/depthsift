{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depthsift:companion:instrument-open:1",
  "title": "DepthSift instrument.open request and response payloads",
  "description": "Specification 1.3, sections 5.4, 9.2, 9.3 and 9.5. The request names the user-selected terminal target and the resolved logical connection. The response distinguishes accepted, confirmed and rejected; confirmed requires an observed target state. The envelope selects request or response by the presence of request_id.",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_target_ref", "target", "instrument_key", "logical_connection_key", "confirm_timeout_ms"],
      "properties": {
        "terminal_target_ref": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "external_id", "link_group"],
          "properties": {
            "kind": {"enum": ["panel", "active_window"]},
            "external_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_id"},
            "link_group": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_id"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "panel"}}},
              "then": {"properties": {"external_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"}}}
            }
          ]
        },
        "instrument_key": {"$ref": "urn:depthsift:companion:common:1#/$defs/instrument_key"},
        "logical_connection_key": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
        "confirm_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 30000}
      }
    },
    "observed_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_id", "instrument_key", "logical_connection_key", "observed_at_ms"],
      "properties": {
        "external_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_id"},
        "instrument_key": {"$ref": "urn:depthsift:companion:common:1#/$defs/instrument_key"},
        "logical_connection_key": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
        "observed_at_ms": {"$ref": "urn:depthsift:companion:common:1#/$defs/milliseconds"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "connection_id_used", "observed_state", "error"],
      "properties": {
        "status": {"enum": ["accepted", "confirmed", "rejected"]},
        "method": {"oneOf": [{"enum": ["panel_ticker_put", "change_ticker"]}, {"type": "null"}]},
        "connection_id_used": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "observed_state": {"oneOf": [{"$ref": "#/$defs/observed_state"}, {"type": "null"}]},
        "error": {"oneOf": [{"$ref": "urn:depthsift:companion:common:1#/$defs/typed_error"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "confirmed"}}},
          "then": {"properties": {"observed_state": {"$ref": "#/$defs/observed_state"}, "error": {"type": "null"}, "method": {"enum": ["panel_ticker_put", "change_ticker"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "accepted"}}},
          "then": {"properties": {"error": {"type": "null"}, "method": {"enum": ["panel_ticker_put", "change_ticker"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "rejected"}}},
          "then": {"properties": {"error": {"$ref": "urn:depthsift:companion:common:1#/$defs/typed_error"}, "observed_state": {"type": "null"}}}
        }
      ]
    }
  }
}
