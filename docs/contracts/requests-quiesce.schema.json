{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depthsift:companion:requests-quiesce:1",
  "title": "DepthSift requests.quiesce payload",
  "description": "Specification 1.3, sections 9.5, 11.2 and 11.4. Asks Companion to stop old operations of one paused scope and to report their outcome for the exact permit list taken from the Core journal. The request itself releases nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["quiesce_id", "limit_scope_id", "limit_epoch", "permit_ids"],
  "properties": {
    "quiesce_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "limit_scope_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
    "limit_epoch": {"$ref": "urn:depthsift:companion:common:1#/$defs/epoch"},
    "permit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"}
    }
  }
}
