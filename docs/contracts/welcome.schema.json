{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depthsift:companion:welcome:1",
  "title": "DepthSift welcome payload",
  "description": "Specification 1.3, sections 9.1, 9.3 and 9.5. Sent by Client with the issued session_id in the envelope and request_id equal to the hello message_id. connection_secret is present only when hello authenticated with a pairing token; it replaces that token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_version", "protocol_version", "accepted_operations", "heartbeat_interval_ms", "disconnect_after_ms", "limits", "limit_scopes"],
  "properties": {
    "client_version": {"$ref": "urn:depthsift:companion:common:1#/$defs/version_string"},
    "protocol_version": {"const": 1},
    "accepted_operations": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:depthsift:companion:common:1#/$defs/operation"}},
    "heartbeat_interval_ms": {"type": "integer", "minimum": 500, "maximum": 10000},
    "disconnect_after_ms": {"type": "integer", "minimum": 1500, "maximum": 60000},
    "limits": {"$ref": "urn:depthsift:companion:common:1#/$defs/limits"},
    "limit_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limit_scope_id", "limit_epoch", "remaining_pause_ms"],
        "properties": {
          "limit_scope_id": {"$ref": "urn:depthsift:companion:common:1#/$defs/id"},
          "limit_epoch": {"$ref": "urn:depthsift:companion:common:1#/$defs/epoch"},
          "remaining_pause_ms": {"$ref": "urn:depthsift:companion:common:1#/$defs/nullable_milliseconds"}
        }
      }
    },
    "connection_secret": {"type": "string", "minLength": 32, "maxLength": 512}
  }
}
